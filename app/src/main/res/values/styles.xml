<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Tetris.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.Tetris.Button.Outlined">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.Tetris.Button.Control" parent="Widget.Tetris.Button.Outlined">
        <item name="strokeColor">@color/grid</item>
        <item name="iconTint">@color/on_surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Widget.Tetris.Button.Control.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>

    <style name="Tetris.Label" parent="">
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
